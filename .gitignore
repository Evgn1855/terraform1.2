# Игнорируем локальный стейт (содержит пароли и секреты ВМ в открытом виде!)
*.tfstate
*.tfstate.*

# Игнорируем логи и результаты выполнения cloud-init, если они скачивались
*.log

# Игнорируем кэш и скачанные провайдеры (папка .terraform весит много)
.terraform/
.terraform.lock.hcl

# Игнорируем переменные с секретами (если вы используете файлы *.auto.tfvars)
*.tfvars
*.tfvars.json

# Игнорируем временные файлы редакторов кода
.idea/
.vscode/
.DS_Store